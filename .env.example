# ============================================================
# HALAL-INVEST PRODUCTION & LOCAL RUNTIME ENVIRONMENT
# ============================================================

# PORT: Server listening port (default: 3000)
PORT=3000
NODE_ENV=production

# DATABASE_URL: PostgreSQL Connection String
# For Local Docker Compose: postgres://halal_user:halal_password@postgres:5432/halal_invest
# For Standalone Mac Postgres: postgres://username:password@localhost:5432/halal_invest
# If omitted or offline, the app operates safely in transactional memory mode.
DATABASE_URL="postgres://halal_user:halal_password@postgres:5432/halal_invest"

# ============================================================
# FYERS BROKER API v3 CREDENTIALS (READ-ONLY)
# ============================================================
# FYERS_SANDBOX: Set to 'true' to run in Sandbox Testing Mode without credentials.
# Set to 'false' once you have your real credentials from https://myapi.fyers.in/
FYERS_SANDBOX=true

# Where you feed your real FYERS credentials:
# 1. Sign in to FYERS API Dashboard: https://myapi.fyers.in/
# 2. Create an App with redirect URI: http://localhost:3000/api/fyers/callback
# 3. Paste your App ID and Secret Key below:
FYERS_APP_ID=""
FYERS_SECRET_KEY=""
FYERS_REDIRECT_URI="http://localhost:3000/api/fyers/callback"
FYERS_ACCESS_TOKEN=""

# AI Studio Hosting URL (Auto-injected in cloud runtime)
APP_URL="http://localhost:3000"
